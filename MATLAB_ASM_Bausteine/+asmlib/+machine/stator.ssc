component stator
% Stator
% Stator winding with three phases U1-U2, V1-V2, W1-W2 (resistance R1, leakage inductance L1sigma).
% Port LS couples to the air gap: the stator feeds its current i1 (alpha-beta) into the air gap
% and sees the main flux linkage psi_h.
%
% Equations (space vectors, amplitude-invariant, stator-fixed; load reference arrows,
% phase current from k1 to k2):
%   u1 = R1*i1 + dpsi1/dt,   psi1 = L1sigma*i1 + psi_h
%   u0 = R1*i0 + L1sigma*di0/dt                     (zero sequence)
%   x = 2/3*(x_U + a*x_V + a^2*x_W),  a = e^(j*2*pi/3),  x0 = (x_U + x_V + x_W)/3
% States: psi1 (alpha-beta) and i0. Initial state: currentless (psi1 = 0 at psi_h = 0, i0 = 0).
% Source: Hagl, R.: Elektrische Antriebstechnik. Hanser, Muenchen 2013

  nodes
    U1 = foundation.electrical.electrical; % U1
    V1 = foundation.electrical.electrical; % V1
    W1 = foundation.electrical.electrical; % W1
    U2 = foundation.electrical.electrical; % U2
    V2 = foundation.electrical.electrical; % V2
    W2 = foundation.electrical.electrical; % W2
    LS = asmlib.airgap; % LS
  end

  outputs
    i1 = {zeros(2, 1), 'A'}; % i1
    u1 = {zeros(2, 1), 'V'}; % u1
  end

  parameters
    R1  = {0.5, 'Ohm'};       % stator resistance R1
    L1s = {9.902e-3, 'H'};    % stator leakage inductance L1sigma
  end

  equations
    assert(R1 > 0, 'Statorwiderstand R1 muss > 0 sein.');
    assert(L1s > 0, 'Statorstreuinduktivität L1σ muss > 0 sein.');
  end

  variables
    iU = {0, 'A'};                % phase current U
    iV = {0, 'A'};                % phase current V
    iW = {0, 'A'};                % phase current W
    i1ab = {zeros(2, 1), 'A'};    % stator current space vector (alpha-beta), flows into the air gap
    psih = {zeros(2, 1), 'Wb'};   % main flux linkage (alpha-beta)
    psi1 = {value = {zeros(2, 1), 'Wb'}, priority = priority.high};   % stator flux linkage psi1
    i0 = {value = {0, 'A'}, priority = priority.high};                % zero-sequence current
  end

  branches
    iU : U1.i -> U2.i;
    iV : V1.i -> V2.i;
    iW : W1.i -> W2.i;
    i1ab : * -> LS.i;
  end

  annotations
    [U1, V1, W1, U2, V2, W2] : Side = left;
    [LS, i1, u1] : Side = right;
  end

  equations
    psih == LS.psi;
    i1ab == [2/3*(iU - iV/2 - iW/2); (iV - iW)/sqrt(3)];
    i0 == (iU + iV + iW)/3;
    let
      uU = U1.v - U2.v;
      uV = V1.v - V2.v;
      uW = W1.v - W2.v;
      uab = [2/3*(uU - uV/2 - uW/2); (uV - uW)/sqrt(3)];
    in
      uab == R1*i1ab + psi1.der;
      (uU + uV + uW)/3 == R1*i0 + L1s*i0.der;
      u1 == uab;
    end
    psi1 == L1s*i1ab + psih;
    i1 == i1ab;
  end

end
