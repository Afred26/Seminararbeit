component grid3
% Three-phase grid
% Symmetrical three-phase grid with star point n brought out, optionally with internal impedance
% per line (R_N, L_N; both 0 = stiff grid). The voltage is applied from t >= t_on
% (switch-on smoothed: e*1/2*(1 + tanh((t - t_on)/0.1 ms)), without solver event).
%
% Equations (source voltages, phase = line against n):
%   e_L1 = sqrt(2)*U/sqrt(3)*sin(w1*t + phi0),  e_L2 = sqrt(2)*U/sqrt(3)*sin(w1*t + phi0 - delta),  e_L3 = ... - 2*delta
%   delta = +2*pi/3 (L1-L2-L3, positive sequence) or -2*pi/3 (L1-L3-L2, negative sequence),  w1 = 2*pi*f1
%   u_k = v_k - v_n = e_k - R_N*i_k - L_N*di_k/dt   (current i_k flows out of terminal k)
% Source: Densborn, lecture notes "Drehstrom & Drehfeld", slides 8-12;
%         Hagl, R.: Elektrische Antriebstechnik. Hanser, Muenchen 2013

  nodes
    a = foundation.electrical.electrical; % a
    b = foundation.electrical.electrical; % b
    c = foundation.electrical.electrical; % c
    n = foundation.electrical.electrical; % n
  end

  parameters
    U_L       = {400, 'V'};     % line voltage U (RMS)
    f1        = {50, 'Hz'};     % frequency f1
    phase_seq = 1;              % phase sequence: 1 = L1-L2-L3, 2 = L1-L3-L2
    phi0      = {0, 'deg'};     % zero phase angle of L1
    t_on      = {0, 's'};       % switch-on time
    R_N       = {0, 'Ohm'};     % grid internal resistance per line
    L_N       = {0, 'H'};       % grid internal inductance per line
  end

  equations
    assert(U_L >= 0, 'Leiterspannung U darf nicht negativ sein.');
    assert(f1 > 0, 'Frequenz f1 muss > 0 sein.');
    assert(phase_seq == 1 || phase_seq == 2, 'Phasenfolge muss 1 oder 2 sein.');
    assert(R_N >= 0 && L_N >= 0, 'R_N und L_N dürfen nicht negativ sein.');
  end

  variables
    ia = {0, 'A'};   % line current L1 (out of terminal a)
    ib = {0, 'A'};   % line current L2
    ic = {0, 'A'};   % line current L3
  end

  branches
    ia : n.i -> a.i;
    ib : n.i -> b.i;
    ic : n.i -> c.i;
  end

  annotations
    [a, b, c, n] : Side = right;
  end

  equations
    let
      Uh  = sqrt(2)*U_L/sqrt(3);
      x   = {2*pi, 'rad'}*f1*time + phi0;
      d   = if phase_seq == 1, {2*pi/3, 'rad'} else {-2*pi/3, 'rad'} end;
      % switch-on smoothed (rise ~ 0.4 ms) so that no solver event occurs
      son = if t_on > 0, 0.5*(1 + tanh((time - t_on)/{1e-4, 's'})) else 1 end;
      ea  = son*Uh*sin(x);
      eb  = son*Uh*sin(x - d);
      ec  = son*Uh*sin(x - 2*d);
    in
      if L_N > 0
        a.v - n.v == ea - R_N*ia - L_N*ia.der;
        b.v - n.v == eb - R_N*ib - L_N*ib.der;
        c.v - n.v == ec - R_N*ic - L_N*ic.der;
      else
        a.v - n.v == ea - R_N*ia;
        b.v - n.v == eb - R_N*ib;
        c.v - n.v == ec - R_N*ic;
      end
    end
  end

end
