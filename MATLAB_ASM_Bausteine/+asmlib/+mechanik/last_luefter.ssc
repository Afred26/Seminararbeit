component last_luefter
% Last Lüfter
% Quadratische Lastkennlinie (Lüfter, Pumpe), wirkt stets gegen die Relativdrehung R gegen C.
%
% Gleichung:  M_L = M_B·(n/n_B)·|n/n_B|
% |x| wird als √(x² + 10⁻⁶) gerechnet (glatt im Stillstand, Fehler < 10⁻⁶·M_B oberhalb 0,1 % n_B).
% Quelle: Densborn, Skript "DS-Asynchron-Motor", Folien 47-56

  nodes
    R = foundation.mechanical.rotational.rotational; % R
    C = foundation.mechanical.rotational.rotational; % C
  end

  parameters
    M_B = {26.5, 'N*m'};   % Bezugsmoment M_B
    n_B = {1440, 'rpm'};   % Bezugsdrehzahl n_B
  end

  equations
    assert(M_B >= 0, 'Bezugsmoment M_B darf nicht negativ sein.');
    assert(n_B > 0, 'Bezugsdrehzahl n_B muss > 0 sein.');
  end

  variables
    t = {0, 'N*m'};   % Lastmoment (aufgenommen)
    w = {0, 'rad/s'}; % Relativdrehzahl
  end

  branches
    t : R.t -> C.t;
  end

  annotations
    [R] : Side = left;
    [C] : Side = right;
  end

  equations
    w == R.w - C.w;
    let
      x = w/n_B;
    in
      t == M_B*x*sqrt(x^2 + 1e-6);
    end
  end

end
