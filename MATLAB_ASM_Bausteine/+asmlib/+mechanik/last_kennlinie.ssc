component last_kennlinie
% Last Kennlinie
% Lastmoment aus einer Tabelle M_L(n) (lineare Interpolation, außerhalb konstant fortgesetzt),
% wirkt stets gegen die Relativdrehung R gegen C.
%
% Gleichung:  M_L = interp(n_tab, M_tab, |n|)·sgn(n),  sgn geglättet mit tanh(Ω/0,1 rad/s)
% Quelle: Densborn, Skript "DS-Asynchron-Motor", Folien 47-56

  nodes
    R = foundation.mechanical.rotational.rotational; % R
    C = foundation.mechanical.rotational.rotational; % C
  end

  parameters
    n_tab = {[0 1500], 'rpm'};     % Stützstellen Drehzahl n
    M_tab = {[0 26.5], 'N*m'};     % Stützstellen Lastmoment M_L
  end

  parameters(ExternalAccess = none)
    w_eps = {0.1, 'rad/s'};        % Glättung der Vorzeichenfunktion
  end

  equations
    assert(length(n_tab) >= 2 && length(n_tab) == length(M_tab), ...
           'n_tab und M_tab brauchen gleich viele Stützstellen (mindestens 2).');
    assert(all(diff(n_tab) > 0), 'n_tab muss streng monoton steigen.');
    assert(all(M_tab >= 0), 'M_tab darf nicht negativ sein.');
  end

  variables
    t = {0, 'N*m'};   % Lastmoment (aufgenommen)
    w = {0, 'rad/s'}; % Relativdrehzahl
  end

  branches
    t : R.t -> C.t;
  end

  annotations
    [R] : Side = left;
    [C] : Side = right;
  end

  equations
    w == R.w - C.w;
    let
      wa = w*tanh(w/w_eps);   % |Ω| glatt, für |Ω| >> Ω_ε exakt
    in
      t == tablelookup(n_tab, M_tab, wa, interpolation = linear, extrapolation = nearest)*tanh(w/w_eps);
    end
  end

end
