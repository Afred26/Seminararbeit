component reibung
% Reibung
% Viskose und trockene (Coulomb-)Reibung zwischen R und C (Lager, Lüfter des Motors).
%
% Gleichung:  M_R = k_R·Ω + M_C·sgn(Ω),  sgn geglättet mit tanh(Ω/0,1 rad/s)
% Quelle: Hagl, R.: Elektrische Antriebstechnik. Hanser, München 2013

  nodes
    R = foundation.mechanical.rotational.rotational; % R
    C = foundation.mechanical.rotational.rotational; % C
  end

  parameters
    k_R = {1e-3, 'N*m*s/rad'};   % Reibbeiwert k_R (viskos)
    M_C = {0, 'N*m'};            % Coulomb-Reibmoment M_C
  end

  parameters(ExternalAccess = none)
    w_eps = {0.1, 'rad/s'};      % Glättung der Vorzeichenfunktion
  end

  equations
    assert(k_R >= 0 && M_C >= 0, 'k_R und M_C dürfen nicht negativ sein.');
  end

  variables
    t = {0, 'N*m'};   % Reibmoment (aufgenommen)
    w = {0, 'rad/s'}; % Relativdrehzahl
  end

  branches
    t : R.t -> C.t;
  end

  annotations
    [R] : Side = left;
    [C] : Side = right;
  end

  equations
    w == R.w - C.w;
    t == k_R*w + M_C*tanh(w/w_eps);
  end

end
