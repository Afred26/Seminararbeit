component ammeter
% Ammeter
% Ideal current sensor (internal resistance 0), connect in series. Positive current flows from p to n.
% The component delivers instantaneous values; the block forms the RMS value in Simulink:
%   I_eff = sqrt( f_meas*int_{t-T}^{t} i^2 dt ),  T = 1/f_meas  (moving window)
% Source: Hagl, R.: Elektrische Antriebstechnik. Hanser, Muenchen 2013

  nodes
    p = foundation.electrical.electrical; % p
    n = foundation.electrical.electrical; % n
  end

  outputs
    i = {0, 'A'}; % i
    i2 = {0, 'A^2'}; % i^2
  end

  variables
    ii = {0, 'A'};   % measured current
  end

  branches
    ii : p.i -> n.i;
  end

  annotations
    [p] : Side = left;
    [n, i, i2] : Side = right;
  end

  equations
    p.v == n.v;
    i == ii;
    i2 == ii^2;
  end

end
