component torque_sensor
% Torque sensor
% Ideal (rigid) torque measuring shaft, connect in series into the shaft line.
%
% Equations:  Om_R = Om_C,  M = torque transmitted from R to C
%   (M > 0 when the motor connected to R drives the load connected to C)
% Source: Hagl, R.: Elektrische Antriebstechnik. Hanser, Muenchen 2013

  nodes
    R = foundation.mechanical.rotational.rotational; % R
    C = foundation.mechanical.rotational.rotational; % C
  end

  outputs
    M = {0, 'N*m'}; % M
  end

  variables
    t = {0, 'N*m'};   % transmitted torque
  end

  branches
    t : R.t -> C.t;
  end

  annotations
    [R] : Side = left;
    [C, M] : Side = right;
  end

  equations
    R.w == C.w;
    M == t;
  end

end
