component load_constant
% Constant load
% Constant load torque (hoist, conveyor), always acts against the relative rotation of R against C.
%
% Equation:  M_L = M_L0*sgn(Om),  Om = Om_R - Om_C
% The sign function is smoothed: sgn(Om) ~ tanh(Om/Om_eps), Om_eps = 0.1 rad/s (~1 rpm),
% so that the solver does not jump between the signs at standstill.
% Source: Densborn, lecture notes "DS-Asynchron-Motor", slides 47-56

  nodes
    R = foundation.mechanical.rotational.rotational; % R
    C = foundation.mechanical.rotational.rotational; % C
  end

  parameters
    M_L0 = {13.25, 'N*m'};   % load torque M_L0
  end

  parameters(ExternalAccess = none)
    w_eps = {0.1, 'rad/s'};  % smoothing of the sign function
  end

  equations
    assert(M_L0 >= 0, 'Lastmoment M_L0 darf nicht negativ sein.');
  end

  variables
    t = {0, 'N*m'};   % load torque (absorbed)
    w = {0, 'rad/s'}; % relative speed
  end

  branches
    t : R.t -> C.t;
  end

  annotations
    [R] : Side = left;
    [C] : Side = right;
  end

  equations
    w == R.w - C.w;
    t == M_L0*tanh(w/w_eps);
  end

end
