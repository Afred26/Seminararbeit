component luftspaltfeld
% Luftspalt-Drehfeld
% Luftspalt mit Hauptinduktivität Lh. Der Port LS sammelt die Ströme von Stator und Rotor
% (Durchflutungsbilanz iμ = i1 + i2′) und gibt die Hauptflussverkettung ψh vor.
%
% Gleichungen:
%   ψh = Lh·iμ
%   φ_el = ∠ψh  (Lage des Flussdichtemaximums, el., statorfest)
%   B̂ = p·|ψh| / (2·N1ξ1·l·r)   (Polfluss Φ = 2·B̂·l·r/p, |ψh| = N1ξ1·Φ)
%   B(γ,t) = B̂·cos(γ − φ_el)
% Quelle: Hagl, R.: Elektrische Antriebstechnik. Hanser, München 2013;
%         Densborn, Skript "Drehstrom & Drehfeld", Folien 59-62

  nodes
    LS = asmlib.luftspalt; % LS
  end

  outputs
    psi_h = {zeros(2, 1), 'Wb'}; % psi_h
    Bhat = {0, 'T'}; % Bhat
    i_mu = {zeros(2, 1), 'A'}; % i_mu
  end

  parameters
    Lh    = {0.25, 'H'};   % Hauptinduktivität Lh
    p     = {2, '1'};      % Polpaarzahl p
    N1xi1 = {144, '1'};    % wirksame Windungszahl N1·ξ1
    l     = {0.15, 'm'};   % wirksame Stablänge l
    r     = {0.06, 'm'};   % Radius der Stabmitte r
  end

  equations
    assert(Lh > 0, 'Hauptinduktivität Lh muss > 0 sein.');
    assert(p >= 1, 'Polpaarzahl p muss >= 1 sein.');
    assert(N1xi1 > 0 && l > 0 && r > 0, 'N1ξ1, l und r müssen > 0 sein.');
  end

  variables
    imu  = {zeros(2, 1), 'A'};   % Magnetisierungsstrom (αβ)
    psih = {zeros(2, 1), 'Wb'};  % Hauptflussverkettung (αβ)
  end

  branches
    imu : LS.i -> *;
  end

  annotations
    [LS] : Side = left;
    [psi_h, Bhat, i_mu] : Side = right;
  end

  equations
    psih == LS.psi;
    psih == Lh*imu;
    psi_h == psih;
    % φ_el = ∠ψh bildet der Baustein in Simulink (atan2 hier würde Solver-Ereignisse erzeugen)
    Bhat == p*sqrt(psih(1)^2 + psih(2)^2)/(2*N1xi1*l*r);
    i_mu == imu;
  end

end
