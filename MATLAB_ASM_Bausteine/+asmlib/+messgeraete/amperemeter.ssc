component amperemeter
% Amperemeter
% Idealer Strommesser (Innenwiderstand 0), in Reihe schalten. Positiver Strom fließt von p nach n.
% Die Komponente liefert Augenblickswerte; den Effektivwert bildet der Baustein in Simulink:
%   I_eff = √( f_mess·∫_{t−T}^{t} i² dt ),  T = 1/f_mess  (gleitendes Fenster)
% Quelle: Hagl, R.: Elektrische Antriebstechnik. Hanser, München 2013

  nodes
    p = foundation.electrical.electrical; % p
    n = foundation.electrical.electrical; % n
  end

  outputs
    i = {0, 'A'}; % i
    i2 = {0, 'A^2'}; % i²
  end

  variables
    ii = {0, 'A'};   % gemessener Strom
  end

  branches
    ii : p.i -> n.i;
  end

  annotations
    [p] : Side = left;
    [n, i, i2] : Side = right;
  end

  equations
    p.v == n.v;
    i == ii;
    i2 == ii^2;
  end

end
