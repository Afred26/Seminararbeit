component leistungsmesser3
% Leistungsmesser 3~
% Dreiphasiger Leistungsmesser: Strompfade in Reihe (Eingang -> Ausgang), Spannungspfade intern
% gegen den künstlichen Sternpunkt v_m = (v_a + v_b + v_c)/3 (Dreileitersystem).
%
% Augenblickswerte (u_k = v_k − v_m):
%   p = u_a·i_a + u_b·i_b + u_c·i_c
%   q = [(u_b − u_c)·i_a + (u_c − u_a)·i_b + (u_a − u_b)·i_c]/√3    (q > 0: induktiv)
%   u2 = Σ u_k²,  i2 = Σ i_k²
% Daraus bildet der Baustein in Simulink (Mittelwert über T = 1/f_mess, gleitend):
%   P = ⟨p⟩, Q = ⟨q⟩, S = √(⟨u2⟩·⟨i2⟩)  (symmetrisch S = 3·U_Str·I = √3·U·I), cos φ = P/S
% Bei Netzen mit Neutralleiterstrom gilt die Messung nur für das Dreileitersystem.
% Quelle: Densborn, Skript "Drehstrom & Drehfeld", Folie 22

  nodes
    a_ein = foundation.electrical.electrical; % a ein
    b_ein = foundation.electrical.electrical; % b ein
    c_ein = foundation.electrical.electrical; % c ein
    a_aus = foundation.electrical.electrical; % a aus
    b_aus = foundation.electrical.electrical; % b aus
    c_aus = foundation.electrical.electrical; % c aus
  end

  outputs
    p = {0, 'W'}; % p
    q = {0, 'V*A'}; % q
    u2 = {0, 'V^2'}; % Σu²
    i2 = {0, 'A^2'}; % Σi²
  end

  variables
    ia = {0, 'A'};
    ib = {0, 'A'};
    ic = {0, 'A'};
  end

  branches
    ia : a_ein.i -> a_aus.i;
    ib : b_ein.i -> b_aus.i;
    ic : c_ein.i -> c_aus.i;
  end

  annotations
    [a_ein, b_ein, c_ein] : Side = left;
    [a_aus, b_aus, c_aus, p, q, u2, i2] : Side = right;
  end

  equations
    a_ein.v == a_aus.v;
    b_ein.v == b_aus.v;
    c_ein.v == c_aus.v;
    let
      vm = (a_ein.v + b_ein.v + c_ein.v)/3;
      ua = a_ein.v - vm;
      ub = b_ein.v - vm;
      uc = c_ein.v - vm;
    in
      p == ua*ia + ub*ib + uc*ic;
      q == ((ub - uc)*ia + (uc - ua)*ib + (ua - ub)*ic)/sqrt(3);
      u2 == ua^2 + ub^2 + uc^2;
      i2 == ia^2 + ib^2 + ic^2;
    end
  end

end
