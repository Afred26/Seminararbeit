component luftspaltsonde
% Luftspalt-Sonde
% Misst das Drehfeld im Luftspalt (wie eine Hallsonde), parallel am Port LS anschließen.
% Die Sonde nimmt keinen Strom auf (Through-Größe 0), sie liest nur ψh.
%
% Gleichungen:
%   φ_el = ∠ψh,   B̂ = p·|ψh| / (2·N1ξ1·l·r),   B(γ,t) = B̂·cos(γ − φ_el)
% Quelle: Hagl, R.: Elektrische Antriebstechnik. Hanser, München 2013;
%         Densborn, Skript "DS-Asynchron-Motor", Folie 14

  nodes
    LS = asmlib.luftspalt; % LS
  end

  outputs
    psi_h = {zeros(2, 1), 'Wb'}; % psi_h
    Bhat = {0, 'T'}; % Bhat
  end

  parameters
    p     = {2, '1'};      % Polpaarzahl p
    N1xi1 = {144, '1'};    % wirksame Windungszahl N1·ξ1
    l     = {0.15, 'm'};   % wirksame Stablänge l
    r     = {0.06, 'm'};   % Radius der Stabmitte r
  end

  equations
    assert(p >= 1 && N1xi1 > 0 && l > 0 && r > 0, 'p, N1ξ1, l und r müssen positiv sein.');
  end

  variables
    psih = {zeros(2, 1), 'Wb'};   % Hauptflussverkettung (αβ)
  end

  annotations
    [LS] : Side = left;
    [psi_h, Bhat] : Side = right;
  end

  equations
    psih == LS.psi;
    psi_h == psih;
    % φ_el = ∠ψh bildet der Baustein in Simulink (atan2 hier würde Solver-Ereignisse erzeugen)
    Bhat == p*sqrt(psih(1)^2 + psih(2)^2)/(2*N1xi1*l*r);
  end

end
