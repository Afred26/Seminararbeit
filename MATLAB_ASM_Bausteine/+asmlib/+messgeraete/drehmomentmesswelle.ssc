component drehmomentmesswelle
% Drehmomentmesswelle
% Ideale (starre) Drehmomentmesswelle, in Reihe in den Wellenstrang schalten.
%
% Gleichungen:  Ω_R = Ω_C,  M = von R nach C übertragenes Moment
%   (M > 0, wenn der an R angeschlossene Motor die an C angeschlossene Last antreibt)
% Quelle: Hagl, R.: Elektrische Antriebstechnik. Hanser, München 2013

  nodes
    R = foundation.mechanical.rotational.rotational; % R
    C = foundation.mechanical.rotational.rotational; % C
  end

  outputs
    M = {0, 'N*m'}; % M
  end

  variables
    t = {0, 'N*m'};   % übertragenes Moment
  end

  branches
    t : R.t -> C.t;
  end

  annotations
    [R] : Side = left;
    [C, M] : Side = right;
  end

  equations
    R.w == C.w;
    M == t;
  end

end
