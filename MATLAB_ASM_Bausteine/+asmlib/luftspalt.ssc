domain luftspalt
% Luftspalt (Raumzeiger, statorfest)
% Schnittstelle zwischen Stator, Luftspalt-Drehfeld und Käfigläufer.
%   Across-Größe: Hauptflussverkettung psi_h = [psi_alpha; psi_beta]  in Wb
%   Through-Größe: Strom i = [i_alpha; i_beta] in A, der in den Luftspalt fließt
% Die Knotenregel (Summe der Ströme = 0) ist die Durchflutungsbilanz
%   i1 + i2' - i_mu = 0,  psi_h = Lh*i_mu.
% Begründung und Varianten: doku/SPEC.md, Abschnitt 7.
% Quelle: Hagl, R.: Elektrische Antriebstechnik. Hanser, München 2013.

  variables
    psi = {zeros(2, 1), 'Wb'};   % Hauptflussverkettung psi_h (alpha, beta)
  end

  variables(Balancing = true)
    i = {zeros(2, 1), 'A'};      % Strom (alpha, beta)
  end

end
